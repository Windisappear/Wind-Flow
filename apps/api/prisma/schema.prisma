generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String           @id @default(uuid())
  name      String
  version   Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  snapshots CanvasSnapshot[]
  nodes     CanvasNode[]
  edges     CanvasEdge[]
}

model CanvasSnapshot {
  id        String   @id @default(uuid())
  projectId String
  version   Int
  data      Json
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, version])
}

model CanvasNode {
  id        String   @id
  projectId String
  type      String
  data      Json
  position  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CanvasEdge {
  id           String   @id
  projectId    String
  source       String
  target       String
  sourceHandle String?
  targetHandle String?
  data         Json?
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Asset {
  id        String   @id @default(uuid())
  kind      String
  name      String
  objectKey String
  hash      String?
  metadata  Json?
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([hash])
}

model GenerationJob {
  id        String   @id @default(uuid())
  nodeId    String?
  state     String
  provider  String?
  model     String?
  input     Json
  output    Json?
  remoteId  String?
  error     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([remoteId])
}

model ProviderCredential {
  id             String   @id
  kind           String
  provider       String
  displayName    String
  modelId        String
  baseUrl        String
  apiMode        String
  endpointPath   String?
  encryptedValue String
  nonce          String
  authTag        String
  updatedAt      DateTime @updatedAt
}

model SkillDefinition {
  id        String   @id @default(uuid())
  name      String
  version   String
  source    String
  schema    Json
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([name, version])
}
